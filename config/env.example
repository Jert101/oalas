# OALASS Environment Configuration Template
# Copy this file to .env.local for development or production.env for production
# Replace all placeholder values with your actual configuration

# Application Configuration
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=oalass_development
MYSQL_USER=oalass_user
MYSQL_PASSWORD=your_secure_db_password_here
DATABASE_URL=mysql://oalass_user:your_secure_db_password_here@localhost:3306/oalass_development

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here_minimum_32_characters
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Configuration
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@localhost

# WebSocket Configuration
WEBSOCKET_PORT=3001
WEBSOCKET_HOST=localhost

# Monitoring Configuration
MONITORING_ENABLED=true
LOG_LEVEL=debug
HEALTH_CHECK_INTERVAL=30

# Security Configuration
SESSION_SECRET=your_session_secret_here_minimum_32_characters
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Performance Configuration
PM2_INSTANCES=1
PM2_MAX_MEMORY_RESTART=1G
