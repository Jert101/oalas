# OALASS Deployment Configuration
# Update these values before running the deployment

# Your Hostinger VPS IP
VPS_IP=72.60.76.125

# Your domain name (replace with your actual domain)
DOMAIN=your-domain.com

# Your email for SSL certificate
EMAIL=your-email@domain.com

# Google OAuth credentials (get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email server configuration
EMAIL_SERVER_USER=your-email@your-domain.com
EMAIL_SERVER_PASSWORD=your_email_password
