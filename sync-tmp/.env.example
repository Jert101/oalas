# Example environment configuration for OALASS
# Copy this file to `.env` and fill in the real values. Do NOT commit secrets.

# Runtime
NODE_ENV=development
# If you run the standalone websocket server locally, it defaults to 3001
PORT=3000

# Database (MySQL)
# Prisma expects DATABASE_URL, not individual DB_* vars
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

# NextAuth
# For local dev, typically http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong random string, e.g. with `openssl rand -base64 32`
NEXTAUTH_SECRET="{{NEXTAUTH_SECRET}}"

# Google OAuth (CKCM domain restriction enforced in code)
GOOGLE_CLIENT_ID="{{GOOGLE_CLIENT_ID}}"
GOOGLE_CLIENT_SECRET="{{GOOGLE_CLIENT_SECRET}}"
# Optional: prompt behavior (select_account | consent)
GOOGLE_OAUTH_PROMPT="select_account"

# Optional GitHub OAuth (leave unset if not used)
GITHUB_CLIENT_ID="{{GITHUB_CLIENT_ID}}"
GITHUB_CLIENT_SECRET="{{GITHUB_CLIENT_SECRET}}"

# Email (Resend)
RESEND_API_KEY="{{RESEND_API_KEY}}"
FROM_EMAIL="noreply@your-domain"

# Realtime/WebSocket server
# For local dev when running websocket-server.js locally:
WEBSOCKET_SERVER_URL="http://localhost:3001"

# Other optional app-specific settings can go here
